{
    "name": "bastihilger/mini-statamic-shop",
    "description": "A small Stripe Checkout shop for Statamic: products, articles, shipping rates, deposits and orders as collections.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": ["statamic", "shop", "stripe", "e-commerce"],
    "authors": [
        {
            "name": "Sebastian Hilger",
            "email": "hilger@kraenk.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "stripe/stripe-php": "^22.0"
    },
    "autoload": {
        "psr-4": {
            "Bastihilger\\MiniStatamicShop\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Mini Statamic Shop",
            "description": "A small Stripe Checkout shop for Statamic",
            "slug": "mini-shop"
        },
        "laravel": {
            "providers": [
                "Bastihilger\\MiniStatamicShop\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
